# Copy to ~/dsh-secrets.env, fill in what you have, then:
#   ./install.sh --secrets ~/dsh-secrets.env
#
# Every line is optional. A blank value means that route is skipped at install
# time and the rest of the setup still completes — top it up later with:
#   dsh-setup reconfigure --secrets ~/dsh-secrets.env
#
# Keep this file out of git. chmod 600 it.

# ── model routes ────────────────────────────────────────────────────────────
# Claude Opus 5 / 4.8 via the TabiToken gateway. This is the DEFAULT session
# model, so without it a new chat has no working route until you pick another.
TABITOKEN_API_KEY=

# One key for the whole OmniRoute gateway: Antigravity (Gemini + Claude),
# Qwen-via-OmniRoute, the free OpenRouter pools and the Codex OAuth route.
OMNIROUTER_API_KEY=

# OpenRouter, used directly rather than through OmniRoute.
OPENROUTER_API_KEY=

# NVIDIA NIM. Also the engine behind the vision toolkit's image reading, so
# without it screenshots fall back to the shared free endpoint (which 429s).
NVIDIA_NIM_API_KEY=

# AgentRouter. Purely API-based — no local process, nothing machine-specific.
AGENTROUTER_API_KEY=

# Google Gemini, direct key.
GEMINI_API_KEY=

# Z.ai / GLM.
ZAI_API_KEY=

# The local Qwen bridge ignores its Authorization header, but pi-ai refuses a
# provider with no credential at all. Leave blank and the installer fills in a
# placeholder for you.
QWEN_BRIDGE_KEY=

# ── MCP servers ─────────────────────────────────────────────────────────────
# Bearer for the Meta Ads MCP bridge. Enables three rows at once: hosted Ads MCP,
# read-only Marketing API, and full campaign management.
META_ADS_BRIDGE_TOKEN=

# Hostinger platform token — mailbox/alias/forwarder/catch-all provisioning.
HOSTINGER_API_TOKEN=

# Hostinger Agentic Mail token — reading, searching and sending messages. A
# DIFFERENT token family from the one above; mint it with
# mcp__hostinger_mail__mail_createAPITokenV1 once the row above is live.
HOSTINGER_MAIL_API_TOKEN=

# ── your own endpoints ──────────────────────────────────────────────────────
# Addresses, not credentials — but they live here so ONE file carries a machine,
# and they are deliberately absent from the repo so it can be public.
# A blank endpoint drops the routes that depend on it; nothing breaks.

# The gateway serving Claude Opus 5 / 4.8 (anthropic-messages API).
# Blank -> the `tabitoken` provider is not written at all, and the default session
# model falls back to Antigravity, then to the local Qwen bridge.
TABITOKEN_BASE_URL=

# Your OmniRoute gateway, including /v1.
# Blank -> antigravity, qwen-omni, the free OmniRoute pools and the Codex OAuth
# route are all dropped.
OMNIROUTE_BASE_URL=

# OmniRoute's provider-node id that fronts your Qwen web session. Model ids on
# that route are "<node-id>/qwen3.8-max" and so on. Blank is fine unless you use
# the qwen-omni provider.
QWEN_OMNI_NODE_ID=

# Origin of your Meta Ads MCP bridge, no trailing slash. Needs
# META_ADS_BRIDGE_TOKEN as well; either one blank drops all three Meta rows.
META_ADS_BRIDGE_URL=

# Optional: user@host of a relay that keeps a Qwen signature fresh for the
# OmniRoute route while this machine is idle. Blank -> the push is skipped.
QWEN_RELAY_SSH=
